# Variables de entorno para desarrollo (Vite las carga automaticamente con `npm run dev`)
# En produccion (`npm run build`) NO se carga este archivo y baseURL queda vacio
# => axios usa rutas relativas same-origin (correcto en Railway donde backend y frontend
#    estan en el mismo dominio).

# URL del backend Spring Boot corriendo localmente en :8080
VITE_API_URL=http://localhost:8080
